#!/usr/bin/env bash
# Fortify pre-push gate (installed by scripts/install-fortify-hook.ps1 / .sh).
#
# Runs the local Fortify scan before a push that updates main. Feature-branch
# pushes are NOT gated (Fortify is slow and ASH already runs in PR CI); the
# gate fires only when you push main directly. To bypass in an emergency:
#     git push --no-verify
#
# git passes the remote name + url as args and the ref list on stdin:
#     <local ref> <local sha> <remote ref> <remote sha>

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCAN="$REPO_ROOT/scripts/fortify_scan.sh"

gate_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) gate_main=1 ;;
  esac
done

if [[ "$gate_main" -ne 1 ]]; then
  exit 0
fi

echo "[pre-push] push updates main -> running Fortify local gate"
if [[ ! -x "$SCAN" ]]; then
  echo "[pre-push] WARNING: $SCAN not found/executable; skipping Fortify gate" >&2
  exit 0
fi

# If not already inside WSL, re-enter it so sourceanalyzer is on PATH.
if grep -qiE "(microsoft|wsl)" /proc/version 2>/dev/null; then
  "$SCAN"
else
  echo "[pre-push] hook running outside WSL; invoking scan via wsl" >&2
  wsl -d Ubuntu-22.04 -- bash -lc "'$SCAN'"
fi
