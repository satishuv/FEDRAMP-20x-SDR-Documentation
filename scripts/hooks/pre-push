#!/usr/bin/env bash
# Local security pre-push gate (installed by scripts/install-fortify-hook.ps1 / .sh).
#
# Runs the local security scans before a push that updates main. Neither ASH
# nor Fortify runs in the external repo's CI any more; they are LOCAL gates.
# Feature-branch pushes are NOT gated (the scans are slow); the gate fires only
# when you push main directly. To bypass in an emergency:
#     git push --no-verify
#
# git passes the remote name + url as args and the ref list on stdin:
#     <local ref> <local sha> <remote ref> <remote sha>

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
ASH_SCAN="$REPO_ROOT/scripts/ash_scan.sh"
FORTIFY_SCAN="$REPO_ROOT/scripts/fortify_scan.sh"

gate_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) gate_main=1 ;;
  esac
done

if [[ "$gate_main" -ne 1 ]]; then
  exit 0
fi

in_wsl() { grep -qiE "(microsoft|wsl)" /proc/version 2>/dev/null; }

# 1. ASH gate.
echo "[pre-push] push updates main -> running ASH local gate"
if command -v ash >/dev/null 2>&1; then
  "$ASH_SCAN"
elif ! in_wsl; then
  echo "[pre-push] invoking ASH scan via wsl" >&2
  wsl -d Ubuntu-22.04 -- bash -lc "'$ASH_SCAN'"
else
  echo "[pre-push] WARNING: 'ash' not on PATH; skipping ASH gate. Install per scripts/ash_scan.sh." >&2
fi

# 2. Fortify gate.
echo "[pre-push] push updates main -> running Fortify local gate"
if [[ ! -x "$FORTIFY_SCAN" ]]; then
  echo "[pre-push] WARNING: $FORTIFY_SCAN not found/executable; skipping Fortify gate" >&2
  exit 0
fi

# If not already inside WSL, re-enter it so sourceanalyzer is on PATH.
if in_wsl; then
  "$FORTIFY_SCAN"
else
  echo "[pre-push] hook running outside WSL; invoking scan via wsl" >&2
  wsl -d Ubuntu-22.04 -- bash -lc "'$FORTIFY_SCAN'"
fi
