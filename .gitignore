# Credentials and secrets: never commit
*.pem
*.key
*.p12
*.pfx
.env
.env.*
credentials*
*credential*
aws-exports*

# Raw evidence and customer material: never commit
evidence/
raw-evidence/
customer-*/
*-customer-*
overrides/

# Python caches
__pycache__/
*.pyc
*.pyo

# Office temp files
~$*
*.tmp

# Editor and OS clutter
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local build logs
*.log

# Local working notes: session logs and dated review reports contain
# engagement context (names, local paths) and stay out of the public repo.
# Remove these two lines only after scrubbing the files.
steering/
quality/

# Collected facts identify a real AWS account: never commit
automation/facts/

# sdrscan reports are around 6 MB per scan and are regenerated on demand, so
# they are treated like any other scanner output: not committed. Continuous
# integration uploads them as build artifacts instead. The scan is
# deterministic, so anyone can reproduce a report exactly from a given commit.
validation/reports/sdrscan/

# A live mutelist suppresses findings and belongs to a specific deployment, so
# it stays local. Copy mutelist.example.json to start one.
automation/sdrscan/mutelist.json
